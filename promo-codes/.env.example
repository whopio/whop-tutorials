# Sandbox credentials. Copy to .env.local and fill in. Never commit .env.local.
# Sandbox dashboard: https://sandbox.whop.com/dashboard

# Developer > Company API keys. Needs promo_code:create, promo_code:basic:read,
# promo_code:delete, access_pass:basic:read, payment:basic:read, plan:basic:read,
# access_pass:create, which `npm run setup` uses to create the product and plan, and
# checkout_configuration:create, checkout_configuration:basic:read, plan:create and
# access_pass:update for the checkout configuration that redirects buyers back.
WHOP_COMPANY_API_KEY=apik_XXXXXXXXXXXX

# From the sandbox dashboard URL.
WHOP_COMPANY_ID=biz_XXXXXXXXXXXX

# true in the sandbox. Remove or set to false in production.
WHOP_SANDBOX=true

# 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# This app's origin, used for the share links and the post-purchase redirect.
# Whop only redirects to https, so on localhost new buyers end on Whop's claim page.
APP_URL=http://localhost:3000
