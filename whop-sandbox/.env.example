# Whop Company API key from the SANDBOX dashboard (sandbox.whop.com/dashboard,
# Business settings > API keys). Needs product/plan create, payment read,
# payment charge/refund, and webhook manage permissions.
WHOP_COMPANY_API_KEY=apik_...

# Your sandbox company id (sandbox dashboard > Settings).
WHOP_COMPANY_ID=biz_...

# true = every SDK call targets sandbox-api.whop.com and the checkout embed
# renders the sandbox checkout. This demo stays true even in production.
WHOP_SANDBOX=true

# iron-session seal password. Generate: openssl rand -base64 32
SESSION_SECRET=

# The app origin (no trailing slash beyond the root).
APP_URL=http://localhost:3000

# Optional: powers the step-6 live webhook feed.
# Neon Postgres connection string; the demo creates one table (demo_webhook_events).
DATABASE_URL=

# Secret of the webhook registered at /api/webhooks/feed (x-whop-signature scheme,
# API-created). Leave empty to disable the feed.
WHOP_FEED_WEBHOOK_SECRET=

# Secret of a dashboard-created webhook pointing at /api/webhooks/whop (the
# article's Standard Webhooks route). Optional for the demo.
WHOP_WEBHOOK_SECRET=
