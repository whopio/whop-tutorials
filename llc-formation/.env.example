# Company API key from the Whop dashboard, Developer page, Company API keys.
# Needs incorporation:write, incorporation:read, company:basic:read and
# webhook_receive:accounts.
WHOP_COMPANY_API_KEY=

# The account the formation is filed against. form_company does not create an
# account, it turns an existing one into a registered company.
WHOP_COMPANY_ID=biz_XXXXXXXXX

# form_company lives under /api-reference/beta and can change without notice,
# so pin the version this was built against.
WHOP_API_VERSION_DATE=2026-08-13

# Must stay true. The route refuses to run against production, because a
# successful production call returns a live $500 checkout link.
WHOP_SANDBOX=true

APP_URL=http://localhost:3000
