# Whop credentials (sandbox during development)
WHOP_COMPANY_API_KEY="apik_..."
WHOP_WEBHOOK_SECRET="..."
WHOP_SANDBOX="true"

# Plan IDs (public, shipped to the client with the checkout embed)
NEXT_PUBLIC_WHOP_SUBSCRIPTION_PLAN_ID="plan_..."
NEXT_PUBLIC_WHOP_LIFETIME_PLAN_ID="plan_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Neon or any Postgres)
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Session cookie secret (32+ chars random)
SESSION_SECRET="<a random string of 32 or more characters>"
