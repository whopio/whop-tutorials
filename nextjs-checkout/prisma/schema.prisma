generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  plan      String    @default("free")
  planType  String?
  planSince DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}
