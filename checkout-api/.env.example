# Company API key from the SANDBOX dashboard (sandbox.whop.com, Developer >
# Company API keys). Needs product, plan and checkout-configuration create,
# payment read, and the webhook permissions.
WHOP_COMPANY_API_KEY=apik_...

# Signing secret shown when you create the webhook in the dashboard. Leave it
# blank until then: checkout works without it. Paste carefully, a trailing
# newline makes every delivery fail its signature check.
WHOP_WEBHOOK_SECRET=

# true = every SDK call targets sandbox-api.whop.com. This demo stays true
# even in production.
WHOP_SANDBOX=true

# The app origin. Also the checkout's returnUrl, so redirect-based payment
# methods land back on this page.
APP_URL=http://localhost:3000
