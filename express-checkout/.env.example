# Whop Company API key from the SANDBOX dashboard (sandbox.whop.com/dashboard,
# Business settings > API keys). Needs payment read and product/plan create.
WHOP_COMPANY_API_KEY=apik_...

# Your sandbox company id (sandbox dashboard > Settings). Only `npm run setup`
# reads it, the app itself doesn't.
WHOP_COMPANY_ID=biz_...

# true = every SDK call targets sandbox-api.whop.com, Whop Elements loads the
# sandbox checkout, and the CSP allows the sandbox hosts. This demo stays true
# even in production.
WHOP_SANDBOX=true

# iron-session seal password. Generate: openssl rand -base64 32
SESSION_SECRET=

# The app origin; also the checkout's returnUrl, so Whop sends the buyer back
# to this page with the result in the address bar.
APP_URL=http://localhost:3000
