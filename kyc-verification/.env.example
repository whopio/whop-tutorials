# Whop Company API key from the SANDBOX dashboard (sandbox.whop.com/dashboard,
# Developer > Company API keys). Needs identity:read, identity:write and
# webhook_receive:identity_profiles. The first two show up with no description
# in the picker, so search for "identity" and take both rows.
WHOP_COMPANY_API_KEY=apik_...

# Your sandbox company id (sandbox dashboard > Settings, or read it out of the
# dashboard URL). Only the demo needs this: it creates a throwaway sub-account
# to verify, because an app with real sellers already has somebody to verify.
WHOP_PLATFORM_ACCOUNT_ID=biz_...

# Signing secret shown when you create the webhook in the dashboard. Paste
# carefully: a trailing newline makes every signature check fail and the error
# says nothing useful.
WHOP_WEBHOOK_SECRET=ws_...

# A mailbox you own. Only the demo needs this. Whop checks that a new account's
# email really accepts mail, so it cannot be invented, and the demo plus-tags
# this one address per throwaway account.
DEMO_SELLER_EMAIL=you@example.com

# true = every SDK call targets sandbox-api.whop.com. This demo stays true even
# in production, because it must never touch a real person's identity.
WHOP_SANDBOX=true

# iron-session seal password, 32 characters or more.
# Generate: openssl rand -base64 32
SESSION_PASSWORD=

# The app origin. The embedded verification element redirects back here.
APP_URL=http://localhost:3000
