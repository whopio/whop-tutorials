# Copy to .env.local and fill in. Never commit .env.local.

# Company API key from the Whop dashboard, Developer, Company API keys.
# It has to be a Company key. An App key cannot add a payout method.
WHOP_COMPANY_API_KEY=

# Our own account. Every seller account we create is parented to this one.
WHOP_PLATFORM_ACCOUNT_ID=

# Signing secret shown when the webhook is created. Paste carefully: a trailing
# newline makes every delivery fail signature checks with no useful error.
# Create the webhook in the dashboard, not through the API. Only dashboard
# webhooks are signed in the scheme the SDK knows how to check.
WHOP_WEBHOOK_SECRET=

# Whop checks that a connected account's email really accepts mail, so the demo
# cannot invent one. It plus-tags this single mailbox per seller instead.
DEMO_SELLER_EMAIL=

# true while building against sandbox. Remove or set false for production.
WHOP_SANDBOX=true

# Encrypts the visitor cookie. Any random string of 32 characters or more.
SESSION_PASSWORD=

# This app's origin. The embedded components redirect back here after
# verification, and they reject localhost, so this must be a real https origin
# for that step to work.
APP_URL=http://localhost:3000
