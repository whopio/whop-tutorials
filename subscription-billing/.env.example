# Sandbox credentials. Copy to .env.local and fill in. Never commit .env.local.
# Sandbox dashboard: https://sandbox.whop.com/dashboard

# Developer > API keys. Needs access_pass:create, access_pass:update, plan:create,
# checkout_configuration:create, checkout_configuration:basic:read, member:basic:read,
# member:email:read, member:manage, membership:cancel and payment:basic:read.
WHOP_COMPANY_API_KEY=apik_XXXXXXXXXXXX

# The monthly plan you created in the dashboard or with the Whop CLI.
WHOP_PLAN_ID=plan_XXXXXXXXXXXX

# Your OAuth app (Developer > Apps): its client id, and its API key as the secret.
# The app needs the oauth:token_exchange permission.
WHOP_CLIENT_ID=app_XXXXXXXXXXXX
WHOP_CLIENT_SECRET=apik_XXXXXXXXXXXX

# Signing secret of the webhook pointed at /api/webhooks/whop. Leave empty until you add one.
WHOP_WEBHOOK_SECRET=

# true in the sandbox. Remove or set to false in production.
WHOP_SANDBOX=true

# 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# This app's origin, with no trailing slash. Used for the sign-in callback and the checkout redirect.
APP_URL=http://localhost:3000
